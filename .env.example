# Copie para .env e preencha. Nunca versione o arquivo .env.
#
# A anon key e publica por natureza: quem protege os dados e a RLS, nao a chave.
# A service_role key ignora RLS e NUNCA pode ir para o app web ou mobile -
# use apenas em scripts locais (carga de cidades, seed em producao).

# --- Web (Vite: precisa do prefixo VITE_) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# --- Mobile (Expo: precisa do prefixo EXPO_PUBLIC_) ---
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Scripts administrativos, fora do app ---
SUPABASE_SERVICE_ROLE_KEY=
