# Copie para .env.local (que o git ignora) e preencha.
#
# O `pnpm dev` NAO usa este arquivo: ele le o .env.development, sempre apontado
# para o Docker. O .env.local so vale para rodar o build de producao na sua
# maquina (`pnpm build` / `pnpm preview`).
#
# Os valores abaixo sao do stack local (`supabase start`). A anon key local e a
# chave de demonstracao publica do Supabase, igual em toda instalacao - nao e
# segredo e pode ficar aqui.
#
# Para apontar para producao, troque pela URL e pela anon key do painel em
# Settings > API. A service_role key NUNCA entra neste arquivo: ela ignora RLS
# e o Vite embute no bundle tudo que comeca com VITE_.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
